{% extends 'base.html.twig' %}

{% block title %}Notre équipe - Amicale Laïque de l'Île-d'Elle{% endblock %}

{% block body %}
<main>
    <aside>
        <div class="titre">
            <h2>Notre équipe</h2>
            <h6>La meilleure</h6>
        </div>
    </aside>

    <section class="equipe">
        {% for membre in membres %}
        <div class="membre">
            <img src="{{ asset(membre.PhotoProfil) }}" alt="{{ asset('picture/pp.png') }}">
            <div class="contenu">
                <h3>{{ membre.nom }}</h3>
                <h5 class="role">{{ membre.role }}</h5>
                <p class="description">
                    {{ membre.description }}
                </p>
            </div>
        </div>
        {% endfor %}
    </section>
</main>
{% endblock %}