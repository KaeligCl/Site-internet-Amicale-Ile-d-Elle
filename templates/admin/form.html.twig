{% extends 'base.html.twig' %}

{% block title %}{{ titrePage }} — Administration{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-header">
        <div>
            <h1>{{ titrePage }}</h1>
            <p>Certains champs sont invalides ou manquants.</p>
        </div>
    </div>

    <section class="admin-card">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="admin-modal-actions">
                <a href="{{ path('app_loged') }}" class="admin-button edit">Retour</a>
                <button type="submit" class="admin-button add">Enregistrer</button>
            </div>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}
