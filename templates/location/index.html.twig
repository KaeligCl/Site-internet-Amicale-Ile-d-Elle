{% extends 'base.html.twig' %}

{% block title %}Location de matériel - Amicale Laïque de l'Île-d'Elle{% endblock %}

{% block body %}
<main>
    <aside>
        <div class="titre">
            <h2>Matériel</h2>
            <h6>On a peut-être ce qu'il vous faut</h6>
        </div>
    </aside>

    {% if reservation_sent %}
        <div class="location-banner success">
            ✅ Votre demande de réservation a bien été envoyée ! Nous vous recontacterons rapidement.
        </div>
    {% elseif reservation_error == 'materiel' %}
        <div class="location-banner error">
            ❌ Le matériel sélectionné est introuvable. Merci de réessayer.
        </div>
    {% elseif reservation_error == 'formulaire' %}
        <div class="location-banner error">
            ❌ Votre demande n'a pas pu être envoyée : vérifiez les champs du formulaire.
        </div>
    {% endif %}

    <section class="location">
        {% for equipement in equipements %}
            <!-- On utilise des classes et des attributs data-* pour stocker les infos -->
            <div class="materiel open-modal-btn"
                 data-equipement-id="{{ equipement.id }}"
                 data-nom="{{ equipement.nom }}"
                 data-image="{{ asset(equipement.image) }}"
                 data-prix-plein="{{ equipement.prixPlein }}"
                 data-prix-membre="{{ equipement.prixMembre }}"
                 data-description="{{ equipement.description }}">

                <img src="{{ asset(equipement.image) }}" alt="{{ equipement.nom }}">
                <div class="materiel-info">
                    <h3>{{ equipement.nom }}</h3>
                    <p>Prix plein : {{ equipement.prixPlein }}€ <br> Membre : {{ equipement.prixMembre }}€</p>
                </div>
            </div>
        {% else %}
            <p class="admin-empty">Aucun matériel disponible pour le moment.</p>
        {% endfor %}

    </section>

    <!-- La modale est Hors de la boucle (présente une seule fois) -->
    <div id="modal-overlay" class="modal-overlay hidden">
        <div class="modal-card">
            <button id="close-modal-btn" class="close-btn" aria-label="Fermer">&times;</button>

            <div class="container-detail">
                <section class="product-info">
                    <img id="modal-img" src="" alt="">
                    <h2 id="modal-title"></h2>
                    <p id="modal-price" class="price-tag"></p>
                    <p id="modal-description" class="modal-desc"></p>
                </section>

                <section class="booking-form">
                    <h3>Réserver ce matériel</h3>
                    {{ form_start(reservationForm) }}
                        {{ form_widget(reservationForm) }}
                        <input type="hidden" name="equipement_id" id="equipement-id-input" value="">
                        <button type="submit" class="submit-btn">Envoyer la demande</button>
                    {{ form_end(reservationForm) }}
                </section>
            </div>
        </div>
    </div>
</main>
{% endblock %}