{% extends 'base.html.twig' %}

{% block title %}Location de matériel - Amicale Laïque de l'Île-d'Elle{% endblock %}

{% block body %}
<main>
    <aside>
        <div class="titre">
            <h2>Location de matériel</h2>
            <h6>On a peut-être ce qu'il vous faut</h6>
        </div>
    </aside>

    <section class="location">
        {% for equipement in equipements %}
        <!-- Bouton pour ouvrir la pop-up -->
            <div id="open-modal-btn" class="materiel">
                <img
                    src="{{ asset('picture/AppareilGauffre.png') }}"
                    alt="{{ equipement.nom }}"
                >

                <h3>{{ equipement.nom }}</h3>
                <p>Prix plein : {{ equipement.prixPlein }}€ / membre : {{ equipement.prixMembre }}€</p>
            </div>

        <!-- Arrière-plan sombre + Fenêtre modale -->
        <div id="modal-overlay" class="modal-overlay hidden">
            <div class="modal-card">
                <button id="close-modal-btn" class="close-btn" aria-label="Fermer">&times;</button>
                
                <div class="container-detail">
                    <section class="product-info">
                        <img src="{{ asset(equipement.image) }}" alt="{{ equipement.nom }}">
                        <h2>{{ equipement.nom }}</h2>
                        <p class="price-tag">Prix plein : {{ equipement.prixPlein }}€ / membre : {{ equipement.prixMembre }}€</p>
                        <p style="color: #666; line-height: 1.6;">
                            {{ equipement.description }}
                        </p>
                    </section>

                    <section class="booking-form">
                        <h3>Réserver ce matériel</h3>
                        <form action="#" method="POST">
                            <div class="form-group">
                                <label for="nom">Nom</label>
                                <input type="text" id="nom" name="nom" placeholder="Votre nom" required>
                            </div>

                            <div class="form-group">
                                <label for="prenom">Prénom</label>
                                <input type="text" id="prenom" name="prenom" placeholder="Votre prénom" required>
                            </div>

                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" placeholder="votre@email.com" required>
                            </div>

                            <div class="form-group">
                                <label for="tel">Numéro de téléphone</label>
                                <input type="tel" id="tel" name="tel" placeholder="06 00 00 00 00" required>
                            </div>

                            <button type="submit" class="submit-btn">Envoyer la demande</button>
                        </form>
                    </section>
                </div>

            </div>
        </div>
        {% endfor %}

    </section>
</main>
{% endblock %}