{% extends 'base.html.twig' %}

{% set jours = {
    'Monday': 'Lundi',
    'Tuesday': 'Mardi',
    'Wednesday': 'Mercredi',
    'Thursday': 'Jeudi',
    'Friday': 'Vendredi',
    'Saturday': 'Samedi',
    'Sunday': 'Dimanche'
} %}

{% set mois = {
    'January': 'Janvier',
    'February': 'Février',
    'March': 'Mars',
    'April': 'Avril',
    'May': 'Mai',
    'June': 'Juin',
    'July': 'Juillet',
    'August': 'Août',
    'September': 'Septembre',
    'October': 'Octobre',
    'November': 'Novembre',
    'December': 'Décembre'
} %}

{% block title %}Événements - Amicale Laïque de l'Île d'Elle{% endblock %}

{% block body %}
    <main>
        <aside>
            <div class="titre">
                <h2>Nos événements</h2>
                <h6>2025-2026</h6>
            </div>
        </aside>

        <section class="bloc-evenements">

            <h3 class="titre-section" style="border-bottom: 3px solid #caffbf;">Événements à Suivre</h3>
            <section class="evenements">
                {% for evenement in evenementsAvenir %}
                    {% include 'evenements/_card_evenement.html.twig' with {'evenement': evenement} %}
                {% else %}
                    <p>Aucun événement à venir.</p>
                {% endfor %}
            </section>

            <h3 class="titre-section" style="border-bottom: 3px solid #ffbfbf;">Événements Passés</h3>
            <section class="evenements">
                {% for evenement in evenementsPasses %}
                    {% include 'evenement/_card_evenement.html.twig' with {'evenement': evenement} %}
                {% else %}
                    <p>Aucun événement passé.</p>
                {% endfor %}
            </section>

        </section>

        {# POPUP / MODALE GALERIE #}
        <div id="gallery-modal-overlay" class="gallery-modal-overlay hidden">
            <div class="gallery-modal">
                <div class="gallery-header">
                    <h3 id="gallery-title">
                        Photos de l'évènement : 
                        <a id="gallery-event-link" href="#" target="_blank" rel="noopener noreferrer" class="event-pop-link"></a>
                    </h3>
                    <button id="close-gallery-btn" class="close-btn">&times;</button>
                </div>
                
                <div id="gallery-grid" class="gallery-grid"></div>
                
                <p class="gallery-footer-text">Cliquez sur une photo pour l'agrandir.</p>
            </div>
        </div>

        {# POPUP PLEIN ÉCRAN POUR IMAGE AGRANDIE #}
        <div id="fullscreen-image-overlay" class="fullscreen-overlay hidden">
            <button id="close-fullscreen-btn" class="close-btn fullscreen-close">&times;</button>
            <img id="fullscreen-image" src="" alt="Photo grand format">
        </div>
    </main>
{% endblock %}