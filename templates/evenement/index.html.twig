{% extends 'base.html.twig' %}

{% set jours = {
    'Monday': 'Lundi',
    'Tuesday': 'Mardi',
    'Wednesday': 'Mercredi',
    'Thursday': 'Jeudi',
    'Friday': 'Vendredi',
    'Saturday': 'Samedi',
    'Sunday': 'Dimanche'
} %}

{% set mois = {
    'January': 'Janvier',
    'February': 'Février',
    'March': 'Mars',
    'April': 'Avril',
    'May': 'Mai',
    'June': 'Juin',
    'July': 'Juillet',
    'August': 'Août',
    'September': 'Septembre',
    'October': 'Octobre',
    'November': 'Novembre',
    'December': 'Décembre'
} %}

{% block title %}Événements - Amicale Laïque de l'Île d'Elle{% endblock %}

{% block body %}
    
    <main>
        <aside>
            <div class="titre">
                <h2>Nos événements</h2>
                <h6>2025-2026</h6>
            </div>
        </aside>
        <section class="bloc-evenements">

            <h3 class="titre-section" style="border-bottom: 3px solid #caffbf"; >Événements à Suivre</h3>
            <section class="evenements">
           
                {% for evenement in evenementsAvenir %}

                <a class="event">
                    <div class="date">
                        <h4 class="jour">{{ evenement.dateDebut|date('d') }}</h4>
                        <h5 class="mois">{{ mois[evenement.dateDebut|date('F')] }}</h5>
                    </div>
                    <div class="contenu">
                        <h3 class="titre-event">{{ evenement.titre }}</h3>
                        <p class="text-event">{{ evenement.description }}</p>
                        <h6 class="journee-heure">{{ jours[evenement.dateDebut|date('l')] }} / {{ evenement.dateDebut|date('H:i') }}{% if evenement.dateFin %} - {{ evenement.dateFin|date('H:i') }}{% endif %}</h6>
                    </div>
                </a>
                {% else %}
                     <p>Aucun événement à venir.</p>
                {% endfor %}

            </section>

            <h3 class="titre-section" style="border-bottom: 3px solid #ffbfbf">Événements Passés</h3>
            <section class="evenements">
           
                {% for evenement in evenementsPasses %}

                <a class="event">
                    <div class="date">
                        <h4 class="jour">{{ evenement.dateDebut|date('d') }}</h4>
                        <h5 class="mois">{{ mois[evenement.dateDebut|date('F')] }}</h5>
                    </div>
                    <div class="contenu">
                        <h3 class="titre-event">{{ evenement.titre }}</h3>
                        <p class="text-event">{{ evenement.description }}</p>
                        <h6 class="journee-heure">{{ jours[evenement.dateDebut|date('l')] }} / {{ evenement.dateDebut|date('H:i') }}{% if evenement.dateFin %} - {{ evenement.dateFin|date('H:i') }}{% endif %}</h6>
                    </div>
                </a>
                {% else %}
                    <p>Aucun événement passé.</p>
                {% endfor %}

            </section>

        </section>

        <div id="gallery-modal-overlay" class="gallery-modal-overlay hidden">
            <div class="gallery-modal">
                <div class="gallery-header">
                    <h3 id="gallery-title">Photos de l'évènement</h3>
                    <button id="close-gallery-btn" class="close-btn">&times;</button>
                </div>
                
                <!-- Grille des photos -->
                <div class="gallery-grid">
                    <!-- Remplace par les vraies images de l'événement -->
                    <img src={{ asset('picture/pp.png') }} alt="Photo 1">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 2">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 3">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 4">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 5">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 6">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 7">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 8">
                    <img src={{ asset('picture/pp.png') }} alt="Photo 9">
                </div>
                
                <p class="gallery-footer-text">9 photos disponibles. Cliquez sur une photo pour l'agrandir.</p>
            </div>
        </div>

                <!-- Modale pour l'image en plein écran -->
        <div id="fullscreen-image-overlay" class="fullscreen-overlay hidden">
            <button id="close-fullscreen-btn" class="close-btn fullscreen-close">&times;</button>
            <img id="fullscreen-image" src="" alt="Image agrandie">
        </div>
    </main>
{% endblock %}

