{% extends 'base.html.twig' %}

{% block title %}Amicale Laïque de l'Île-d'Elle{% endblock %}

{% block body %}
<main>
    <aside>
        <div class="titre">
            <h2>L'Association</h2>
            <h6>Qui sommes-nous ?</h6>
        </div>
    </aside>

    <section class="presentation">
        <article class="intro-text">
            <h3>Plus qu'une association, un collectif</h3>

            <p>
                Depuis de nombreuses années, l'<strong>Amicale Laïque de l'Île d'Elle</strong>
                s'engage pour faire vivre le village à travers des événements culturels,
                festifs et solidaires. Notre mission est simple : créer du lien entre les
                habitants et soutenir les projets éducatifs.
            </p>
        </article>

        <div class="stats-grid">
            <div class="stat-item">
                <span class="nombre">17</span>
                <p>Bénévoles actifs</p>
            </div>

            <div class="stat-item">
                <span class="nombre">12</span>
                <p>Événements prévus pour cette année</p>
            </div>

            <div class="stat-item">
                <span class="nombre">1929</span>
                <p>Année de création</p>
            </div>
        </div>

        <div class="valeurs">
            <div class="valeur-card">
                <div class="icon">🤝</div>
                <h4>Solidarité</h4>
                <p>Soutenir les écoles et les projets locaux.</p>
            </div>

            <div class="valeur-card">
                <div class="icon">🎉</div>
                <h4>Convivialité</h4>
                <p>Organiser des moments de joie partagés.</p>
            </div>

            <div class="valeur-card">
                <div class="icon">🕊️</div>
                <h4>Laïcité</h4>
                <p>Un accueil pour tous, sans distinction.</p>
            </div>
        </div>

        <div class="rejoindre-asso">
            <h3>Envie de nous donner un coup de main ?</h3>
            <p>Rejoignez-nous pour contribuer à la vitalité de notre communauté !</p>

            <a
                href="https://www.helloasso.com/associations/amicale-laique85/adhesions/adhesion-amicale-laique-ile-d-elle-2025-2026"
                target="_blank"
                class="btn"
            >
                Devenir Bénévole
            </a>

            <a
                href="https://www.helloasso.com/associations/amicale-laique85/formulaires/3"
                target="_blank"
                class="btn"
            >
                Faire un don
            </a>
        </div>
    </section>
</main>
{% endblock %}