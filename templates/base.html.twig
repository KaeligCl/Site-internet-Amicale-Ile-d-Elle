<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>{% block title %}Amicale Laïque de l'Île d'Elle{% endblock %}</title>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>
        <header>
            <div class="Tete">
                <div class="Logo-Container">
                    <img
                        src="{{ asset('picture/LOGO.png') }}"
                        class="LogoHead"
                        alt="Logo de l'Amicale Laïque de l'Île d'Elle"
                    >
                </div>

                <h1>
                    <span class="TitreL1">Amicale Laïque</span>
                    <span class="TitreL2">L'Île d'Elle</span>
                </h1>

                <div class="Empty-Space"></div>
            </div>

<nav class="NavBar">
    <div class="nav-mobile-header">
        <span class="active-page-title">
            {% set route = app.request.attributes.get('_route') %}
            {% if route == 'app_home' %}Qui sommes-nous ?
            {% elseif route == 'app_evenement' %}Événements
            {% elseif route == 'app_reunion' %}Réunions
            {% elseif route == 'app_equipe' %}Équipe
            {% elseif route == 'app_location' %}Location
            {% else %}Menu{% endif %}
        </span>
        <button class="nav-toggle" id="navToggle" aria-label="Ouvrir le menu">
            &#9776; </button>
    </div>

    <div class="nav-links" id="navLinks">
        <a class="box {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">
            <p>Qui sommes-nous ?</p>
        </a>
        <a class="box {{ app.request.attributes.get('_route') == 'app_evenement' ? 'active' : '' }}" href="{{ path('app_evenement') }}">
            <p>Événements</p>
        </a>
        <a class="box {{ app.request.attributes.get('_route') == 'app_reunion' ? 'active' : '' }}" href="{{ path('app_reunion') }}">
            <p>Réunions</p>
        </a>
        <a class="box {{ app.request.attributes.get('_route') == 'app_equipe' ? 'active' : '' }}" href="{{ path('app_equipe') }}">
            <p>Équipe</p>
        </a>
        <a class="box {{ app.request.attributes.get('_route') == 'app_location' ? 'active' : '' }}" href="{{ path('app_location') }}">
            <p>Location</p>
        </a>
    </div>
</nav>
        </header>

        {% block body %}{% endblock %}

        <footer class="site-footer">
            <div class="footer-content">
                <a
                    class="box {{ app.request.attributes.get('_route') == 'app_mentions' ? 'active' : '' }}"
                    href="{{ path('app_mentions') }}"
                >
                    Mentions légales
                </a>

                <div class="social-links">
                    <a
                        href="https://www.facebook.com/p/Association-Amicale-La%C3%AFque-de-L%C3%AEle-dElle-100080288599304/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                    >
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                    </a>

                    <a
                        href="https://www.instagram.com/amicalelaiqueliledelle/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                    >
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.948-.196-4.354-2.618-6.78-6.979-6.98-1.281-.059-1.689-.073-4.948-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.209-1.791 4-4 4zm6.406-11.845c0 .796-.646 1.441-1.441 1.441-.796 0-1.441-.645-1.441-1.441s.645-1.441 1.441-1.441c.795 0 1.441.645 1.441 1.441z"/>
                        </svg>
                    </a>

                    <a
                        href="https://www.helloasso.com/associations/amicale-laique85"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="HelloAsso"
                    >
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </footer>
    </body>
</html>

