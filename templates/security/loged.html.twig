{% macro modal(dialogId, titre, form, submitLabel, deleteAction = null, message = null) %}
<dialog class="admin-modal" id="{{ dialogId }}">
    <div class="admin-modal-content">
        <div class="admin-modal-header">
            <h3>{{ titre }}</h3>
            <button type="button" class="admin-modal-close" data-close aria-label="Fermer">&times;</button>
        </div>

        {% if deleteAction %}
            <p class="admin-modal-text">{{ message }}</p>
            <form method="post" action="{{ deleteAction }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dialogId) }}">
                <div class="admin-modal-actions">
                    <button type="button" class="admin-button edit" data-close>Annuler</button>
                    <button type="submit" class="admin-button delete">Oui, supprimer</button>
                </div>
            </form>
        {% else %}
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="admin-modal-actions">
                    <button type="button" class="admin-button edit" data-close>Annuler</button>
                    <button type="submit" class="admin-button add">{{ submitLabel }}</button>
                </div>
            {{ form_end(form) }}
        {% endif %}
    </div>
</dialog>
{% endmacro %}

{% extends 'base.html.twig' %}

{% block nav %}{% endblock %}

{% block body %}

<div class="admin-container">

<div class="admin-header">
    <div>
        <h1>Administration</h1>
        <p>Gestion du site</p>
    </div>

    <a href="{{ path('app_logout') }}" class="logout-button">
        Se déconnecter
    </a>
</div>


<div class="admin-grid">

    {# ================= ÉVÉNEMENTS ================= #}

    <section class="admin-card">
        <div class="admin-card-title">
            <h2>Événements</h2>
            <span class="admin-number">01</span>
        </div>

        <button type="button" class="admin-add-button" data-modal-open="modal-evenement-add">
            + Ajouter un événement
        </button>

        <div class="admin-list">

            {% for evenement in evenements %}
                <div class="admin-item">

                    <div class="admin-item-info">
                        <strong>{{ evenement.titre }}</strong>
                        <span>
                            {{ evenement.dateDebut|date('d/m/Y H:i') }}
                            —
                            {{ evenement.lieu }}
                        </span>
                    </div>

                    <div class="admin-item-actions">
                        <button type="button" class="admin-button edit" data-modal-open="modal-evenement-edit-{{ evenement.id }}">
                            Modifier
                        </button>

                        <button type="button" class="admin-button delete" data-modal-open="modal-evenement-delete-{{ evenement.id }}">
                            Supprimer
                        </button>
                    </div>

                </div>
            {% else %}
                <p class="admin-empty">Aucun événement.</p>
            {% endfor %}

        </div>
    </section>


    {# ================= RÉUNIONS ================= #}

    <section class="admin-card">
        <div class="admin-card-title">
            <h2>Réunions</h2>
            <span class="admin-number">02</span>
        </div>

        <button type="button" class="admin-add-button" data-modal-open="modal-reunion-add">
            + Ajouter une réunion
        </button>

        <div class="admin-list">

            {% for reunion in reunions %}
                <div class="admin-item">

                    <div class="admin-item-info">
                        <strong>{{ reunion.titre }}</strong>
                        <span>
                            {{ reunion.date|date('d/m/Y H:i') }}
                        </span>
                    </div>

                    <div class="admin-item-actions">
                        <button type="button" class="admin-button edit" data-modal-open="modal-reunion-edit-{{ reunion.id }}">
                            Modifier
                        </button>

                        <button type="button" class="admin-button delete" data-modal-open="modal-reunion-delete-{{ reunion.id }}">
                            Supprimer
                        </button>
                    </div>

                </div>
            {% else %}
                <p class="admin-empty">Aucune réunion.</p>
            {% endfor %}

        </div>
    </section>


    {# ================= ÉQUIPE ================= #}

    <section class="admin-card">
        <div class="admin-card-title">
            <h2>Équipe</h2>
            <span class="admin-number">03</span>
        </div>

        <button type="button" class="admin-add-button" data-modal-open="modal-equipe-add">
            + Ajouter un membre
        </button>

        <div class="admin-list">

            {% for membre in equipe %}
                <div class="admin-item">

                    <div class="admin-item-info">
                        <strong>{{ membre.nom }}</strong>
                        <span>{{ membre.role }}</span>
                    </div>

                    <div class="admin-item-actions">
                        <button type="button" class="admin-button edit" data-modal-open="modal-equipe-edit-{{ membre.id }}">
                            Modifier
                        </button>

                        <button type="button" class="admin-button delete" data-modal-open="modal-equipe-delete-{{ membre.id }}">
                            Supprimer
                        </button>
                    </div>

                </div>
            {% else %}
                <p class="admin-empty">Aucun membre.</p>
            {% endfor %}

        </div>
    </section>


    {# ================= LOCATIONS ================= #}

    <section class="admin-card">
        <div class="admin-card-title">
            <h2>Locations</h2>
            <span class="admin-number">04</span>
        </div>

        <button type="button" class="admin-add-button" data-modal-open="modal-equipement-add">
            + Ajouter une location
        </button>

        <div class="admin-list">

            {% for location in locations %}
                <div class="admin-item">

                    <div class="admin-item-info">
                        <strong>{{ location.nom }}</strong>
                        <span>
                            {{ location.prixPlein }} € —
                            {% if location.encoreDisponible %}
                                Disponible
                            {% else %}
                                Indisponible
                            {% endif %}
                        </span>
                    </div>

                    <div class="admin-item-actions">
                        <button type="button" class="admin-button edit" data-modal-open="modal-equipement-edit-{{ location.id }}">
                            Modifier
                        </button>

                        <button type="button" class="admin-button delete" data-modal-open="modal-equipement-delete-{{ location.id }}">
                            Supprimer
                        </button>
                    </div>

                </div>
            {% else %}
                <p class="admin-empty">Aucune location.</p>
            {% endfor %}

        </div>
    </section>

</div>

{# ============================================================ #}
{# ==================== POPUPS (DIALOGS) ====================== #}
{# ============================================================ #}

{% import _self as m %}

{# --- Événements --- #}
{{ m.modal('modal-evenement-add', 'Ajouter un événement', evenementForm, 'Ajouter') }}
{% for evenement in evenements %}
    {{ m.modal('modal-evenement-edit-' ~ evenement.id, 'Modifier : ' ~ evenement.titre, editForms[evenement.id], 'Enregistrer') }}
    {{ m.modal('modal-evenement-delete-' ~ evenement.id, 'Supprimer ?', null, null,
        path('app_admin_evenement_delete', {'id': evenement.id}),
        'Supprimer « ' ~ evenement.titre ~ ' » ? Cette action est irréversible.') }}
{% endfor %}

{# --- Réunions --- #}
{{ m.modal('modal-reunion-add', 'Ajouter une réunion', reunionForm, 'Ajouter') }}
{% for reunion in reunions %}
    {{ m.modal('modal-reunion-edit-' ~ reunion.id, 'Modifier : ' ~ reunion.titre, reunionEditForms[reunion.id], 'Enregistrer') }}
    {{ m.modal('modal-reunion-delete-' ~ reunion.id, 'Supprimer ?', null, null,
        path('app_admin_reunion_delete', {'id': reunion.id}),
        'Supprimer « ' ~ reunion.titre ~ ' » ? Cette action est irréversible.') }}
{% endfor %}

{# --- Équipe --- #}
{{ m.modal('modal-equipe-add', 'Ajouter un membre', equipeForm, 'Ajouter') }}
{% for membre in equipe %}
    {{ m.modal('modal-equipe-edit-' ~ membre.id, 'Modifier : ' ~ membre.nom, equipeEditForms[membre.id], 'Enregistrer') }}
    {{ m.modal('modal-equipe-delete-' ~ membre.id, 'Supprimer ?', null, null,
        path('app_admin_equipe_delete', {'id': membre.id}),
        'Retirer « ' ~ membre.nom ~ ' » de l\'équipe ? Cette action est irréversible.') }}
{% endfor %}

{# --- Équipements --- #}
{{ m.modal('modal-equipement-add', 'Ajouter une location', equipementForm, 'Ajouter') }}
{% for location in locations %}
    {{ m.modal('modal-equipement-edit-' ~ location.id, 'Modifier : ' ~ location.nom, equipementEditForms[location.id], 'Enregistrer') }}
    {{ m.modal('modal-equipement-delete-' ~ location.id, 'Supprimer ?', null, null,
        path('app_admin_equipement_delete', {'id': location.id}),
        'Supprimer « ' ~ location.nom ~ ' » ? Cette action est irréversible.') }}
{% endfor %}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Ouvrir une modale
        document.querySelectorAll('[data-modal-open]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const dialog = document.getElementById(btn.dataset.modalOpen);
                if (dialog) dialog.showModal();
            });
        });

        // Fermer une modale (croix / Annuler / clic sur le fond)
        document.querySelectorAll('dialog.admin-modal').forEach((dialog) => {
            dialog.querySelectorAll('[data-close]').forEach((btn) => {
                btn.addEventListener('click', () => dialog.close());
            });

            dialog.addEventListener('click', (e) => {
                if (e.target === dialog) dialog.close();
            });
        });
    });
</script>

</div>

{% endblock %}
