{% extends 'base.html.twig' %}

{% set jours = {
    'Monday': 'Lundi',
    'Tuesday': 'Mardi',
    'Wednesday': 'Mercredi',
    'Thursday': 'Jeudi',
    'Friday': 'Vendredi',
    'Saturday': 'Samedi',
    'Sunday': 'Dimanche'
} %}

{% set mois = {
    'January': 'Janvier',
    'February': 'Février',
    'March': 'Mars',
    'April': 'Avril',
    'May': 'Mai',
    'June': 'Juin',
    'July': 'Juillet',
    'August': 'Août',
    'September': 'Septembre',
    'October': 'Octobre',
    'November': 'Novembre',
    'December': 'Décembre'
} %}

{% block title %}Notre Réunion - Amicale Laïque de l'Île-d'Elle{% endblock %}

{% block body %}
<main>

    <aside>
        <div class="titre">
            <h2>Nos Réunions</h2>
            <h6>Les Comptes Rendus</h6>
        </div>
    </aside>

    <section class="reunions">
        {% for reunion in reunions %}
            <article class="card-reunion">
                <h3>{{ reunion.titre }}</h3>
                <h6>Date : {{ reunion.date|date('d/m/Y') }}</h6>
                <p>{{ reunion.texte|nl2br }}</p>
            </article>
        {% else %}
            <p class="admin-empty">Aucun compte rendu de réunion pour le moment.</p>
        {% endfor %}
        </section>

    </main>
    {% endblock %}
