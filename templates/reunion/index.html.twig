{% extends 'base.html.twig' %}

{% block title %}Notre Réunion - Amicale Laïque de l'Île-d'Elle{% endblock %}

{% block body %}
<main>

    <aside>
        <div class="titre">
            <h2>Nos Réunion</h2>
            <h6>Les Comptes Rendus</h6>
        </div>
    </aside>

</main>
{% endblock %}
{#

    <section class="reunions-grid">
        {% for reunion in reunions %}
            <article class="card-reunion">
                <header class="reunion-header">
                    <div class="reunion-date">
                        <!-- Format de date propre (ex: 15 Oct. 2026) -->
                        <span class="day">{{ reunion.date|date('d') }}</span>
                        <span class="month-year">{{ reunion.date|date('M Y') }}</span>
                    </div>
                    
                    <div class="reunion-title-group">
                        <span class="badge">Compte rendu</span>
                        <h3>{{ reunion.titre }}</h3>
                    </div>
                </header>

                <div class="reunion-content">
                    <p>{{ reunion.texte }}</p>
                </div>

                <!-- Optionnel : Un bouton de téléchargement ou d'action -->
                <footer class="reunion-footer">
                    <a href="#" class="btn-read-more">Lire la suite</a>
                </footer>
            </article>
        {% endfor %}
    </section>
#}